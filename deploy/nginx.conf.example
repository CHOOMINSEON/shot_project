# Place this location inside your HTTPS server block. Set a real hostname and TLS certificate there.
# Preserve HTTPS X-Forwarded-* headers; expose uvicorn only to this trusted proxy.
location / {
    client_max_body_size 9m;
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}
# Media jobs run outside HTTP requests; do not increase request bodies to 10GB or hold requests for two hours.
